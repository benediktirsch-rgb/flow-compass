[Unit]
Description=Compass Postfach und Slack lesend aufbereiten
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=compass
Group=compass
Environment=HOME=/home/compass
Environment=TZ=Europe/Berlin
UMask=0077
ExecStart=/usr/bin/python3 /opt/compass-vertretung/connectors.py
TimeoutStartSec=35min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/compass-server/daten/vertretung /home/compass/.codex
