[Unit]
Description=Compass-Server (Coach, Stapel, Trello, Jira) — produkt/server unter PowerShell 7
Documentation=file:///opt/compass-server/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=compass
Group=compass
WorkingDirectory=/opt/compass-server
# Schlüssel (Trello, Jira, CLAUDE_CODE_OAUTH_TOKEN) — nur root lesbar, nie im Repo.
EnvironmentFile=-/etc/compass-server/env
Environment=TZ=Europe/Berlin
Environment=LANG=de_DE.UTF-8
Environment=LC_ALL=de_DE.UTF-8
Environment=HOME=/home/compass
Environment=PATH=/home/compass/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=POWERSHELL_TELEMETRY_OPTOUT=1
Environment=DISABLE_AUTOUPDATER=1
ExecStart=/usr/bin/pwsh -NoProfile -NonInteractive -File /opt/compass-server/compass-server.ps1 -Konfig /etc/compass-server/compass-server.json
Restart=always
RestartSec=5
# Der Server arbeitet seriell; ein Coach-Aufruf darf bis zu 7 Minuten dauern.
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=multi-user.target
