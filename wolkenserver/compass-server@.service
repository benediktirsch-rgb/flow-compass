[Unit]
Description=Compass-Server für die Instanz %i (Coach, Stapel, Trello, Jira)
Documentation=file:///opt/compass-server/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=compass
Group=compass
WorkingDirectory=/opt/compass-server
# Schlüssel der Instanz (Trello, Jira, CLAUDE_CODE_OAUTH_TOKEN der Person) — nur root lesbar.
EnvironmentFile=-/etc/compass-server/instanzen/%i.env
Environment=TZ=Europe/Berlin
Environment=LANG=de_DE.UTF-8
Environment=LC_ALL=de_DE.UTF-8
Environment=HOME=/home/compass
Environment=PATH=/home/compass/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=POWERSHELL_TELEMETRY_OPTOUT=1
Environment=DISABLE_AUTOUPDATER=1
ExecStart=/usr/bin/pwsh -NoProfile -NonInteractive -File /opt/compass-server/compass-server.ps1 -Konfig /etc/compass-server/instanzen/%i.json
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=multi-user.target
